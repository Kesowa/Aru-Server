<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <title>Reset Password</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.3/css/bulma.min.css">
    <link rel="stylesheet" href="style.css">
    <link href="/your-path-to-fontawesome/css/all.css" rel="stylesheet">
    <style>
    .wrapper {
      min-height: calc(100vh - 150px);
    }
    .container {
      width: 700px;
      margin: auto;
    }
    .container2 {
      width: 500px;
      margin: auto;
    }
    .container3 {
      width: 800px;
      margin: auto;
    }
    .footer {
      height: 50px;
    }
    </style>
  </head>
  <body>
      <div class="wrapper">
        <nav class="navbar" role="navigation" aria-label="main navigation">
            <div class="navbar-brand">
              <a class="navbar-item" href="https://nkda.kesowa.com"></a>
              <img src="https://img1.wsimg.com/isteam/ip/b7677be8-ebdc-4f0d-8153-7945cd34ed4b/Kesowa-Square-Logo-0001.jpg/:/rs=w:118,h:118,cg:true,m/cr=w:118,h:118/qt=q:95" width="80" height="80">
            </div>
        </nav>
        <section class="section">
            <div class="container">
              <h1 class="title">
                Change password
              </h1>
              <p class="subtitle">
                Before you proceed logging into <strong>ARU</strong>, please set a new password.
              </p>
            </div>
            
        </section>

        <% if (message) { %>
            <div class="container3">
                <div class="notification is-danger is-light">
                    <button class="delete"></button>
                    <%= message %>
                </div>
            </div>
        <% } %>
        
        <section class="section">
            <div class="container2">
                <form class="box" action="/apis/v1/auth/reset-password/<%= token %>" method="POST">              
                  <div class="field">
                      <label class="label" for="password">New password</label>
                      <div class="control">
                        <input class="input" type="password" name="password" placeholder="********">
                      </div>
                    </div>
                    <input type="text" name="token" value="<%= token %>" hidden />
                    <div class="field">
                        <label class="label"for="password2">Confirm password</label>
                        <div class="control">
                          <input class="input" type="password" name="password2" placeholder="********">
                        </div>
                      </div>
                  
                    <button class="button is-primary" type="submit">Change password</button>
                </form>
            </div>
        </section>
      </div>
    <footer class="footer">
        <div class="content has-text-centered">
          <p>
            <strong>ARU</strong> by <a href="https://www.kesowa.com">Kesowa Infinite Ventures Pvt. Ltd</a>. 
          </p>
        </div>
      </footer>
      
  </body>
</html>