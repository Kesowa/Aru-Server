<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.3/css/bulma.min.css">
  <script src="https://unpkg.com/feather-icons"></script>
</head>
<body>
  <div
    style="
      width: 100vw;
      height: 100vh;
      background: linear-gradient(
        180deg,
        rgba(136, 129, 240, 1) 0%,
        rgba(219, 218, 250, 1) 100%
      );
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    "
  >
    <div
      style="
        width: 50%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      "
    >
      <div style="background-color: white; border-radius: 10px; width: 80%">
        <div
          style="
            width: 90%;
            height: 90%;
            margin-top: 10%;
            margin-bottom: 5%;
            margin-left: 5%;
            margin-right: 5%;
          "
        >
          <div
            style="
              position: absolute;
              top: 80px;
              border-radius: 50%;
              background: linear-gradient(
                180deg,
                rgba(116, 169, 240, 1) 0%,
                rgba(83, 65, 208, 1) 100%
              );
              padding: 10px;
              height: 100px;
              width: 100px;
              display: flex;
              justify-content: center;
              align-items: center;
            "
          >
            <i
              style="display: block; height: 80%; width: 80%; stroke: white"
              data-feather="lock"
            ></i>
          </div>
          <h1 class="title" style="color: rgb(107, 55, 228)">
            Forgot your password?
          </h1>
          <p>Hey, we recieved a request to reset your password</p>
          <br />
          <p>Let's get you a new one!</p>
          <br />
          <a
            style="
              color: white; 
              background-color: rgb(107, 55, 228);
              border-radius: 10px;
              padding: 10px;
              text-decoration: none;"
            href="<%= resetPasswordUrl %>"
            >RESET MY PASSWORD</a
          >
          <br />
          <br />
          <p>
            If this wasn't you, please report at
            <a href="mailto:admin@kesowa.com">admin@kesowa.com</a>
          </p>
          <br />
          <p>
            Please do not share this email or the password reset link, as it can
            compromise your account access and organization data!
          </p>
          <br />
          <p>Best regards,</p>
          <p><b>Team Kesowa</b></p>
        </div>
      </div>
      <footer style="width: 100%">
        <div class="content has-text-centered" style="text-align: center;">
          <img
            style="display: block; border-radius: 50%; margin: 20px auto"
            src="https://img1.wsimg.com/isteam/ip/b7677be8-ebdc-4f0d-8153-7945cd34ed4b/Kesowa-Square-Logo-0001.jpg/:/rs=w:118,h:118,cg:true,m/cr=w:118,h:118/qt=q:95"
            width="80"
            height="80"
          />
          <p>
            <strong>ARU</strong> by
            <a
              href="https://www.kesowa.com"
              style="color: rgb(72, 72, 72); text-decoration: underline"
              ><strong>Kesowa Infinite Ventures Pvt. Ltd</strong></a
            >
          </p>
        </div>
      </footer>
    </div>
  </div>
  <script>
    feather.replace()
  </script>
</body>
</html>

