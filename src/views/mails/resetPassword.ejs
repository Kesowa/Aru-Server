<div>
  <div
    style="
      background: linear-gradient(
        180deg,
        rgba(136, 129, 240, 1) 0%,
        rgba(219, 218, 250, 1) 100%
      );
    "
  >
    <div style="width: 50%; margin: auto; padding: 50px 0px;">
      <div
        style="
          background-color: white;
          border-radius: 10px;
          width: 100%;
          padding: 10px 0px;
        "
      >
        <div
          style="
            width: 90%;
            height: 90%;
            margin: 5%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 16px;
          "
        >
          <h1 class="title" style="color: rgb(107, 55, 228); font-size: 32px;">
            Forgot your password?
          </h1>
          <p>Hey, we recieved a request to reset your password</p>
          <p>Let's get you a new one!</p>
          <br />
          <a
            style="
              color: white;
              background-color: rgb(107, 55, 228);
              border-radius: 10px;
              padding: 10px;
              text-decoration: none;
            "
            href="<%= resetPasswordUrl %>"
            >RESET MY PASSWORD</a
          >
          <br />
          <br />
          <p>
            If this wasn't you, please report at
            <a href="mailto:admin@kesowa.com">admin@kesowa.com</a>
          </p>
          <p>
            Please do not share this email or the password reset link, as it can
            compromise your account access and organization data!
          </p>
          <br />
          <p>Best regards,</p>
          <p><b>Team Kesowa</b></p>
        </div>
      </div>
      <footer>
        <div class="content has-text-centered" style="text-align: center">
          <img
            style="display: block; border-radius: 50%; margin: 20px auto"
            src="https://img1.wsimg.com/isteam/ip/b7677be8-ebdc-4f0d-8153-7945cd34ed4b/Kesowa-Square-Logo-0001.jpg/:/rs=w:118,h:118,cg:true,m/cr=w:118,h:118/qt=q:95"
            width="80"
            height="80"
          />
          <p>
            <strong>ARU</strong> by
            <a
              href="https://www.kesowa.com"
              style="color: rgb(72, 72, 72); text-decoration: underline"
              ><strong>Kesowa Infinite Ventures Pvt. Ltd</strong></a
            >
          </p>
        </div>
      </footer>
    </div>
  </div>
</div>
