FROM node:18
WORKDIR /app
RUN apt-get update && apt-get -y install libtbb2
ADD ./ffmpeg.tar.gz /bin
ADD  ./potree.tar.gz /bin
ADD ./dji_bin.tar.gz /bin
ADD ./dji_lib.tar.gz /lib
RUN cp /bin/liblaszip.so /usr/lib/liblaszip.so
COPY package*.json ./
RUN npm ci
COPY ./tsconfig.json ./
ENV NODE_ENV=development
CMD ["npm", "run", "dev"]

